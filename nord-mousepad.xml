<?xml version="1.0" encoding="UTF-8"?>

<style-scheme id="nord-mousepad" name="mousepad-nord-theme" version="1.0">

    <author>PotatoPoweredDev</author>
    <description>Nord color scheme</description>

    
    <!-- Nord Color Palette -->

    <color name="Background" value="#2E3440"/>
    <color name="Lighter_background" value="#3B4252"/>
    <color name="Selection" value="#434C5E"/>
    <color name="Comment" value="#616E88"/>
    <color name="Foreground" value="#D8DEE9"/>
    <color name="Bright_Text" value="#ECEFF4"/>
    <color name="Brightest_UI_elements" value="#E5E9F0"/>
    <color name="Classes" value="#8FBCBB"/>
    <color name="Function" value="#88C0D0"/>
    <color name="Variable" value="#D8DEE9"/>
    <color name="Keywords" value="#81A1C1"/>
    <color name="Errors" value="#BF616A"/>
    <color name="Constants" value="#D08770"/>
    <color name="Warnings" value="#EBCB8B"/>
    <color name="Strings" value="#A3BE8C"/>
    <color name="Booleans" value="#B48EAD"/>

    <!-- Global Settings -->

    <style name="text" foreground="#D8DEE9" background="#2E3440"/>
    <style name="selection" foreground="#ECEFF4" background="#434C5E"/>
    <style name="selection-unfocused" foreground="#D8DEE9" background="#3B4252"/>
    <style name="cursor" foreground="#D8DEE9" background="#2E3440"/>
    <style name="secondary-cursor" foreground="#2E3440" background="#81A1C1"/>
    <style name="current-line" foreground="#D8DEE9" background="#3B4252"/>
    <style name="line-number" foreground="#4C566A" background="#2E3440"/>

    <!-- Bracket Matching -->

    <style name="bracket-match" foreground="#A3BE8C" background="#2E3440"/>
    <style name="bracket-mismatch" foreground="#BF616A" background="#2E3440"/>

    <!-- Search -->

    <style name="search-match" foreground="#2E3440" background="#EBCB8B"/>

    <!-- Right Margin -->

    <style name="right-margin" foreground="#4C566A" background="#2E3440"/>

    <!-- Comments -->

    <style name="def:comment" foreground="#616E88" background="#2E3440" italic="true"/>
    <style name="def:shebang" foreground="#616E88" background="#2E3440"/>
    <style name="def:doc-comment-element" italic="true"/>

    <!-- Constants -->

    <style name="def:constant" foreground="#D08770" background="#2E3440"/>
    <style name="def:special-char" foreground="#B48EAD" background="#2E3440"/>
    <style name="def:boolean" foreground="#B48EAD" background="#2E3440"/>
    <style name="def:special-constant" foreground="#B48EAD" background="#2E3440"/>
    
    <!-- Identifiers -->

    <style name="def:identifier" foreground="#D8DEE9" background="#2E3440"/>
    <style name="def:function" foreground="#88C0D0" background="#2E3440"/>
    <style name="def:builtin" foreground="#8FBCBB" background="#2E3440"/>
    <!-- Statements -->

    <style name="def:statement" foreground="#81A1C1" background="#2E3440"/>

    <!-- Operator -->
    <style name="def:operator" foreground="#81A1C1" background="#2E3440"/>
    
    <!-- Types -->

    <style name="def:type" foreground="#8FBCBB" background="#2E3440" bold="true"/>

    <!-- Markup -->

    <style name="def:emphasis" foreground="#D8DEE9" background="#2E3440" italic="true"/>
    <style name="def:strong-emphasis" foreground="#ECEFF4" background="#2E3440" bold="true"/>
    <style name="def:inline-code" foreground="#A3BE8C" background="#2E3440"/>
    <style name="def:insertion" foreground="#A3BE8C" background="#2E3440" underline="single"/>
    <style name="def:deletion" foreground="#BF616A" background="#2E3440" strikethrough="true"/>
    <style name="def:link-text" foreground="#88C0D0" background="#2E3440"/>
    <style name="def:link-symbol" foreground="#81A1C1" background="#2E3440" bold="true"/>
    <style name="def:link-destination" italic="true" underline="single"/>
    <style name="def:heading" foreground="#8FBCBB" background="#2E3440" bold="true"/>
    <style name="def:thematic-break" foreground="#4C566A" background="#2E3440" bold="true"/>
    <style name="def:preformatted-section" foreground="#D8DEE9" background="#2E3440"/>
    <style name="def:list-marker" foreground="#81A1C1" background="#2E3440" bold="true"/>

    <!-- Others -->

    <style name="def:preprocessor" foreground="#5E81AC" background="#2E3440"/>
    <style name="def:error" foreground="#BF616A" background="#2E3440" bold="true"/>
    <style name="def:warning" foreground="#EBCB8B" background="#2E3440"/>
    <style name="def:note" foreground="#88C0D0" background="#2E3440"/>
    <style name="def:base-n-integer" foreground="#B48EAD" background="#2E3440"/>
    <style name="def:net-address-in-comment" foreground="#88C0D0" background="#2E3440" italic="true" underline="true"/>
    <style name="def:underline" italic="true" underline="true"/>

    <!-- Heading styles -->

    <style name="def:heading0" scale="5.0"/>
    <style name="def:heading1" scale="2.5"/>
    <style name="def:heading2" scale="2.0"/>
    <style name="def:heading3" scale="1.7"/>
    <style name="def:heading4" scale="1.5"/>
    <style name="def:heading5" scale="1.3"/>
    <style name="def:heading6" scale="1.2"/>

    <!-- Language specific styles -->

    <style name="diff:added-line" foreground="#A3BE8C" background="#2E3440"/>
    <style name="diff:removed-line" foreground="#BF616A" background="#2E3440"/>
    <style name="diff:changed-line" use-style="def:preprocessor"/>
    <style name="diff:special-case" use-style="def:constant"/>
    <style name="diff:location" use-style="def:statement"/>
    <style name="diff:diff-file" use-style="def:type"/>

    <style name="xml:tags" foreground="#81A1C1" background="#2E3440"/>
    <style name="xml:attribute-name" foreground="#8FBCBB" background="#2E3440"/>
    <style name="xml:namespace" foreground="#5E81AC" background="#2E3440" bold="true"/>

    <style name="js:built-in-constructor" use-style="def:identifier"/>

    <style name="latex:display-math" foreground="#D08770" background="#2E3440"/>
    <style name="latex:command" foreground="#81A1C1" background="#2E3440" bold="true"/>
    <style name="latex:include" use-style="def:preprocessor"/>

    <style name="sh:variable" foreground="#D8DEE9" background="#2E3440"/>

    <!-- legacy styles for old lang files -->

    <style name="Others" foreground="#81A1C1" background="#2E3440" bold="true"/>
    <style name="Others 2" foreground="#D8DEE9" background="#2E3440"/>
    <style name="Others 3" foreground="#4C566A" background="#2E3440"/>
  
    <!-- Fix little of python -->
  
    <style name="python:builtin-function" use-style="def:builtin"/>
    <style name="python:builtin-constant" use-style="def:special-constant"/>
    <style name="python:module-handler" use-style="def:preprocessor"/>

</style-scheme>
